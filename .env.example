# JEV / TypeSafe provider
TYPESAFE_API_KEY=
# JEV_API_KEY=                       # optional alias if preferred locally
JEV_ENDPOINT=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest
JEV_TIMEOUT_SECONDS=30
# JEV_INCLUDE_RAW=false              # debugging only; MCP returns normalized output by default
# JEV_ENV_FILE=/absolute/path/.env   # optional; default is .env in the current working directory

# MCP server
MCP_TRANSPORT=streamable-http
MCP_HOST=127.0.0.1                  # V0.1 intentionally allows loopback only
MCP_PORT=8000
